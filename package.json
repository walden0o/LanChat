{
  "name": "local-qq-server",
  "version": "0.1.0",
  "private": true,
  "description": "局域网即时通讯工具（服务端 + 静态托管前端）",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:client": "npm --prefix client run build",
    "backup": "node scripts/backup.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "socket.io": "^4.8.1"
  }
}
